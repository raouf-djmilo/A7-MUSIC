index 0000000..242265b
--- /dev/null
+++ b/node_modules/expo-sensors/ios/EXMotionPermissionRequester.swift
@@ -0,0 +1,41 @@
+// Copyright 2021-present 650 Industries. All rights reserved.
+
+import Foundation
+import CoreMotion
+import ExpoModulesCore
+
+@objc(EXMotionPermissionRequester)
+public class EXMotionPermissionRequester: NSObject, EXPermissionsRequester {
+  public static func permissionType() -> String {
+    return "motion"
+  }
+
+  public func getPermissions() -> [AnyHashable : Any] {
+    var status = EXPermissionStatusDenied
+    if Bundle.main.object(forInfoDictionaryKey: "NSMotionUsageDescription") == nil {
+      status = EXPermissionStatusDenied
+    } else {
+      switch CMPedometer.authorizationStatus() {
+      case .authorized:
+        status = EXPermissionStatusGranted
+      case .denied, .restricted:
+        status = EXPermissionStatusDenied
+      case .notDetermined:
+        status = EXPermissionStatusUndetermined
+      @unknown default:
+        status = EXPermissionStatusDenied
+      }
+    }
+    return ["status": status.rawValue]
+  }
+
+  public func requestPermissions(resolver resolve: @escaping EXPromiseResolveBlock, rejecter reject: @escaping EXPromiseRejectBlock) {
+    let manager = CMPedometer()
+    let today = Date()
+    manager.queryPedometerData(from: today, to: today) { [weak self] _, _ in
+      guard let self = self else { return }
+      manager.stopUpdates()
+      resolve(self.getPermissions())
+    }
+  }
+}
