{
  "expo": {
    "name": "A7 MUSIC",
    "slug": "myapp",
    "version": "1.5.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.a77jmilo.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.a77jmilo.myapp",
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nouble to access your photos to share them in chat.",
          "cameraPermission": "Allow Nouble to access your camera to take photos for chat."
        }
      ],
      "expo-media-library",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "usePrecompiledHeaders": true,
            "networkInspector": false,
            "extraProguardRules": "-keep class com.doublesymmetry.trackplayer.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.reactnativecommunity.webview.** { *; }"
          },
          "ios": {
            "ccacheEnabled": true,
            "usePrecompiledModules": true,
            "networkInspector": false
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e4a2fac6-c96c-4930-825a-dc56ce8bcc75"
      }
    }
  }
}
